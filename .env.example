# Copy this file to .env and fill in your values

SECRET_KEY=change-me-to-a-random-string
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
CREDENTIALS_FILE=credentials.json

# Public address used in links sent to parents (no trailing slash).
# Leave blank to derive it from the request, but set it in production so a
# proxy misconfiguration can never put http:// or 127.0.0.1 in a shared link.
PUBLIC_BASE_URL=https://hadirskbt.altrabird.click

# Set to 1 once HTTPS is enabled in nginx. Leave blank on plain HTTP,
# otherwise the login cookie is dropped and nobody can sign in.
SESSION_COOKIE_SECURE=

# Shared password teachers use to sign in. The fallback in app.py is public on
# GitHub — set a NEW value here on every deployment.
SETTINGS_PASSWORD=

# Name printed on the warning letter
SCHOOL_NAME=SEKOLAH KEBANGSAAN BANDAR TAWAU

# Telegram (optional — leave blank to disable notifications entirely)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_PAGI=
TELEGRAM_CHAT_PETANG=
TELEGRAM_SECRET=hadirskbt
